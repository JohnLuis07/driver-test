+static int
+panvk_v19_find_plane_fd(const native_handle_t *raw, uint64_t allocation,
+                        uint64_t plane_end)
+{
+   int exact = -1, sufficient = -1;
+   unsigned exact_count = 0, sufficient_count = 0;
+   const uint64_t minimum = MAX2(allocation, plane_end);
+   for (int i = 0; i < raw->numFds; i++) {
+      const int fd = raw->data[i];
+      const bool valid = fd >= 0 && fcntl(fd, F_GETFD) >= 0;
+      const off_t size = valid ? lseek(fd, 0, SEEK_END) : -1;
+      int error = size < 0 ? errno : 0;
+      if (!valid && fd < 0)
+         error = EBADF;
+      if (size >= 0)
+         lseek(fd, 0, SEEK_SET);
+      mesa_logi("[PANVK-DMABUF] %s index=%d valid=%d size=%lld allocation=%llu planeEnd=%llu errno=%d",
+                __func__, i, valid, (long long)size, (unsigned long long)allocation,
+                (unsigned long long)plane_end, error);
+      if (size <= 0 || (uint64_t)size < minimum)
+         continue;
+
+      sufficient = i;
+      sufficient_count++;
+      if ((uint64_t)size == allocation) {
+         exact = i;
+         exact_count++;
+      }
+   }
+
+   if (exact_count == 1)
+      return exact;
+   if (sufficient_count == 1)
+      return sufficient;
+
+   mesa_logw("[PANVK-DMABUF] %s unable to identify one backing FD (exact=%u sufficient=%u)",
+             __func__, exact_count, sufficient_count);
+   return -1;
 }
 
