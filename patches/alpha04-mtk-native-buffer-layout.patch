+VKAPI_ATTR VkResult VKAPI_CALL
+panvk_GetSwapchainGrallocUsageANDROID(VkDevice device, VkFormat format,
+                                      VkImageUsageFlags image_usage, int *usage)
+{
+   VkResult result =
+      vk_common_GetSwapchainGrallocUsageANDROID(device, format, image_usage, usage);
+   if (result == VK_SUCCESS && panvk_android_prefer_linear_swapchain(device, format))
+      *usage |= PANVK_MALI_GRALLOC_USAGE_NO_AFBC | GRALLOC_USAGE_HW_COMPOSER;
+
+   mesa_logi("[PANVK-WSI] %s format=%d usage=0x%x vkresult=%d",
+             __func__, format, result == VK_SUCCESS ? *usage : 0, result);
+   return result;
+}
+
+VKAPI_ATTR VkResult VKAPI_CALL
