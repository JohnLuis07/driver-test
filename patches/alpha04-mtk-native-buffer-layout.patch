+static bool
+vk_android_mtk_linear_layout(const VkImageCreateInfo *create,
+                              const VkNativeBufferANDROID *anb,
+                              VkSubresourceLayout *layout, int *plane_fd)
+{
+   const native_handle_t *handle = anb->handle;
+   if (handle->numFds != 3 || handle->numInts < 45 ||
+       handle->data[21] != 0x03141592 || create->arrayLayers != 1 ||
+       create->flags & VK_IMAGE_CREATE_PROTECTED_BIT ||
+       (create->format != VK_FORMAT_R8G8B8A8_UNORM &&
+        create->format != VK_FORMAT_R8G8B8A8_SRGB &&
+        create->format != VK_FORMAT_B8G8R8A8_UNORM &&
+        create->format != VK_FORMAT_B8G8R8A8_SRGB) ||
+       ((create->format == VK_FORMAT_B8G8R8A8_UNORM ||
+         create->format == VK_FORMAT_B8G8R8A8_SRGB) ?
+        anb->format != HAL_PIXEL_FORMAT_BGRA_8888 :
+        (anb->format != HAL_PIXEL_FORMAT_RGBA_8888 &&
+         anb->format != HAL_PIXEL_FORMAT_RGBX_8888)))
+      return false;
+
+   const uint32_t width = create->extent.width, height = create->extent.height;
+   if (!width || !height || anb->stride <= 0)
+      return false;
+
+   const int *data = &handle->data[21];
+   const struct {
+      unsigned dimensions, plane;
+   } candidates[] = {{2, 21}, {1, 16}};
+   uint64_t pitch = 0, size = 0;
+   unsigned matched = 0;
+   for (unsigned i = 0; i < ARRAY_SIZE(candidates); i++) {
+      const unsigned d = candidates[i].dimensions, p = candidates[i].plane;
+      const uint32_t alloc_format = data[p - 5];
+      if (data[d] != width || data[d + 1] != height ||
+          data[d + 2] != anb->format || data[p - 4] != 0 ||
+          (alloc_format != (uint32_t)anb->format && (i != 1 || alloc_format != 0)) ||
+          data[p] <= 0 || data[p + 1] < width || data[p + 2] < height ||
+          data[p + 3] != 0 || (uint64_t)data[p] != (uint64_t)anb->stride * 4 ||
+          (uint64_t)data[p] < (uint64_t)data[p + 1] * 4)
+         continue;
+      pitch = data[p];
+      size = pitch * (uint32_t)data[p + 2];
+      matched++;
+   }
+   if (matched != 1)
+      return false;
+
+   int selected = -1;
+   for (int i = 0; i < handle->numFds; i++) {
+      const int fd = handle->data[i];
+      const bool valid = fd >= 0 && fcntl(fd, F_GETFD) >= 0;
+      const off_t fd_size = valid ? lseek(fd, 0, SEEK_END) : -1;
+      if (fd_size >= 0)
+         lseek(fd, 0, SEEK_SET);
+      mesa_logi("[PANVK-DMABUF] %s fdIndex=%d fd=%d valid=%d size=%lld minimum=%llu",
+                __func__, i, fd, valid, (long long)fd_size, (unsigned long long)size);
+      if (fd_size <= 0 || (uint64_t)fd_size < size)
+         continue;
+      if (selected >= 0)
+         return false;
+      selected = i;
+   }
+   if (selected < 0)
+      return false;
+
+   *plane_fd = handle->data[selected];
+   *layout = (VkSubresourceLayout){.offset = 0, .rowPitch = pitch};
+   mesa_logi("[PANVK-GRALLOC] %s recognized MTK linear layout fdIndex=%d pitch=%llu",
+             __func__, selected, (unsigned long long)pitch);
+   return true;
+}
